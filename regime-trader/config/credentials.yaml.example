# =============================================================================
# Esempio di file credenziali — NON committare il file reale (credentials.yaml)
# Copia questo file in credentials.yaml e inserisci i valori reali
# =============================================================================

alpaca:
  api_key: "your_alpaca_api_key_here"
  secret_key: "your_alpaca_secret_key_here"
  paper: true                            # true = paper trading endpoint

# Opzionale: webhook per alert (es. Slack, Discord)
alerts:
  webhook_url: "https://hooks.example.com/your-webhook"
  email: "your_email@example.com"
